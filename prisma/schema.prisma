generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PASSED
  DELETED
}

model User {
  id           String @id @default(uuid()) @db.Uuid
  email        String @unique
  passwordHash String

  firstName String?
  lastName  String?

  role   UserRole   @default(CUSTOMER)
  status UserStatus @default(ACTIVE)

  emailVerifiedAt  DateTime?
  twoFactorEnabled Boolean   @default(false)
  passedAt         DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  recipients      Recipient[]
  trustedContacts TrustedContact[]
  messages        Message[]
  mediaAssets     MediaAsset[]

  memoryVaultItems       MemoryVaultItem[]
  memoryVaultMediaAssets MemoryVaultMediaAsset[]

  myStoryResponses MyStoryResponse[]
  myWishResponses  MyWishResponse[]

  deathVerificationCase DeathVerificationCase?

  // ADMIN / SUPER_ADMIN only (Step 16).
  adminMfaCredential    AdminMfaCredential?
  adminMfaRecoveryCodes AdminMfaRecoveryCode[]
}

// Admin TOTP (Step 16). Written by setup with enabledAt null; confirm sets
// enabledAt. The secret is AES-256-GCM encrypted with ADMIN_TOTP_ENCRYPTION_KEY
// and never leaves the API after enrollment.
model AdminMfaCredential {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  totpSecretEncrypted String
  enabledAt           DateTime?
  // RFC 6238 time step of the last accepted code; replays of it or older fail.
  lastUsedTimeStep    BigInt?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One-time admin recovery codes. Only a SHA-256 of each (80-bit) code is stored.
model AdminMfaRecoveryCode {
  id       String    @id @default(uuid()) @db.Uuid
  userId   String    @db.Uuid
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash String    @unique
  usedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
}

enum AuditEventType {
  ADMIN_PASSWORD_AUTH_SUCCEEDED
  ADMIN_MFA_SETUP_COMPLETED
  ADMIN_MFA_VERIFIED
  ADMIN_MFA_FAILED
  ADMIN_RECOVERY_CODE_USED
  ADMIN_LOGIN
  ADMIN_LOGOUT
  USER_SUSPENDED
  USER_REACTIVATED
  ADMIN_VIEWED_USER
  ADMIN_VIEWED_DEATH_CASE
  DEATH_VERIFICATION_VERIFIED
  DEATH_VERIFICATION_REJECTED
  FAILED_JOB_RETRIED
}

// Only admin actors write generic audit rows so far.
enum AuditActorType {
  ADMIN
  SUPER_ADMIN
}

// Generic append-only audit trail (Step 16). The migration adds a trigger that
// rejects UPDATE and DELETE. Plain ids, no FKs, so history outlives accounts.
// Never holds secrets, codes, private content or raw IPs (ipPrefix is /24 or /48).
model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  eventType   AuditEventType
  actorType   AuditActorType
  actorUserId String?        @db.Uuid

  subjectType String?
  subjectId   String?

  ipPrefix  String?
  userAgent String?

  metadata Json?

  createdAt DateTime @default(now())

  @@index([eventType])
  @@index([actorUserId])
  @@index([subjectType, subjectId])
  @@index([createdAt])
}

// "People I Love". A contact record owned by one customer, not a login account.
model Recipient {
  id          String @id @default(uuid()) @db.Uuid
  ownerUserId String @db.Uuid
  owner       User   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  firstName    String
  lastName     String?
  relationship String?
  email        String?
  mobile       String?
  // Calendar date only (no time/timezone), so it cannot shift a day.
  birthday     DateTime? @db.Date
  privateNote  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  messageRecipients MessageRecipient[]
  accessGrants      RecipientMessageAccessGrant[]

  @@index([ownerUserId])
}

// Nominated to help with post-death actions. An owned contact record, never
// a User: no password or role. Signs in by email OTP (Step 14) to report a
// death, and gets no access to the owner's content.
// The migration adds a CHECK that email or mobile is set.
model TrustedContact {
  id          String @id @default(uuid()) @db.Uuid
  ownerUserId String @db.Uuid
  owner       User   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  firstName    String
  lastName     String?
  relationship String?
  email        String? // stored normalized (trim + lowercase)
  mobile       String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  deathReports DeathReport[]

  @@index([ownerUserId])
  // Trusted Contact OTP eligibility and account lookup by signed-in email.
  @@index([email])
}

// PENDING_VERIFICATION → SAFEGUARD_ACTIVE → READY_FOR_REVIEW → VERIFIED (Step 15).
// CANCELLED (Customer confirmed alive, from any open state) and REJECTED
// (admin, from READY_FOR_REVIEW) are terminal, like VERIFIED.
enum DeathVerificationCaseStatus {
  PENDING_VERIFICATION
  SAFEGUARD_ACTIVE
  READY_FOR_REVIEW
  VERIFIED
  REJECTED
  CANCELLED
}

// One canonical case per Customer. A report is NOT proof of death. Only an
// explicit admin verification (VERIFIED) activates death-triggered Messages;
// nothing else changes the User, Messages, schedules, releases or grants.
model DeathVerificationCase {
  id          String @id @default(uuid()) @db.Uuid
  ownerUserId String @unique @db.Uuid
  owner       User   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  status     DeathVerificationCaseStatus @default(PENDING_VERIFICATION)
  openedAt   DateTime                    @default(now())
  // Set with every terminal status (VERIFIED, REJECTED, CANCELLED).
  resolvedAt DateTime?

  // Safety notice to the account holder; the safeguard starts only after a
  // successful send. safeguardEndsAt is stored, so a later config change never
  // moves a running window.
  safetyNoticeSentAt        DateTime?
  safetyNoticeLastAttemptAt DateTime?
  safetyNoticeAttemptCount  Int       @default(0)
  safeguardStartedAt        DateTime?
  safeguardEndsAt           DateTime?

  // verifiedDeathAt = the approved time of death (drives AFTER_DEATH);
  // verifiedAt = when For After approved it (drives ON_DEATH).
  verifiedAt      DateTime?
  verifiedDeathAt DateTime?
  // Admin ids are kept as plain history (no FK), like audit actors.
  verifiedByUserId String?   @db.Uuid
  rejectedAt       DateTime?
  rejectedByUserId String?   @db.Uuid
  cancelledAt      DateTime?
  // Admin-only; never returned to Customers, Trusted Contacts or Recipients.
  adminDecisionNote String?

  // Activation rows were built for every then-scheduled death-trigger Message.
  // Not proof that anything has been released.
  deathTriggersActivatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reports     DeathReport[]
  auditEvents DeathVerificationAuditEvent[]
  activations DeathTriggeredMessageActivation[]

  @@index([status])
}

enum DeathVerificationAuditEventType {
  REPORT_RECEIVED
  SAFETY_NOTICE_SENT
  SAFEGUARD_STARTED
  SAFEGUARD_ELAPSED
  CUSTOMER_CONFIRMED_ALIVE
  ADMIN_VERIFIED
  ADMIN_REJECTED
  DEATH_TRIGGER_ACTIVATION_STARTED
  DEATH_TRIGGER_ACTIVATION_COMPLETED
}

enum DeathVerificationActorType {
  SYSTEM
  CUSTOMER
  TRUSTED_CONTACT
  ADMIN
}

// Append-only history of a case. Written in the same transaction as the change
// it records. No free text or JSON: notes live on the case/report only.
model DeathVerificationAuditEvent {
  id                      String                @id @default(uuid()) @db.Uuid
  deathVerificationCaseId String                @db.Uuid
  deathVerificationCase   DeathVerificationCase @relation(fields: [deathVerificationCaseId], references: [id], onDelete: Cascade)

  eventType DeathVerificationAuditEventType
  actorType DeathVerificationActorType
  // Plain ids (no FK) so history survives a later account or contact deletion.
  actorUserId           String? @db.Uuid
  actorTrustedContactId String? @db.Uuid

  createdAt DateTime @default(now())

  @@index([deathVerificationCaseId, createdAt])
}

// Durable execution state for ON_DEATH / AFTER_DEATH Messages after a VERIFIED
// case. MessageSchedule keeps its original meaning; dueAt lives here.
model DeathTriggeredMessageActivation {
  id        String  @id @default(uuid()) @db.Uuid
  messageId String  @unique @db.Uuid
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  deathVerificationCaseId String                @db.Uuid
  deathVerificationCase   DeathVerificationCase @relation(fields: [deathVerificationCaseId], references: [id], onDelete: Cascade)

  triggerType ReleaseTriggerType
  activatedAt DateTime
  // ON_DEATH: verifiedAt. AFTER_DEATH: verifiedDeathAt + afterDeathDays.
  dueAt       DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deathVerificationCaseId])
  @@index([dueAt])
}

// One report per Trusted Contact per case. Reporter details are snapshots
// taken at submission, so later edits to the TrustedContact never change it.
model DeathReport {
  id                      String                @id @default(uuid()) @db.Uuid
  deathVerificationCaseId String                @db.Uuid
  deathVerificationCase   DeathVerificationCase @relation(fields: [deathVerificationCaseId], references: [id], onDelete: Cascade)

  // Cascade, like RecipientMessageAccessGrant: Restrict/NoAction would block
  // deleting the owner's account, because PostgreSQL checks them after the
  // TrustedContact cascade and before the case cascade. The API only
  // soft-deletes Trusted Contacts, so reports survive a contact's removal;
  // the only hard delete is the owner's, which removes the case anyway.
  reportedByTrustedContactId String         @db.Uuid
  reportedByTrustedContact   TrustedContact @relation(fields: [reportedByTrustedContactId], references: [id], onDelete: Cascade)

  reporterFirstNameSnapshot String
  reporterLastNameSnapshot  String?
  reporterEmailNormalized   String?
  reporterMobileNormalized  String?

  // Calendar date only (no time/timezone), so it cannot shift a day.
  reportedDateOfDeath DateTime? @db.Date
  note                String?

  createdAt DateTime @default(now())

  @@unique([deathVerificationCaseId, reportedByTrustedContactId])
  @@index([reportedByTrustedContactId])
}

// Future values are defined now; the API only accepts TEXT until media exists.
enum MessageContentType {
  TEXT
  VIDEO
  AUDIO
  PHOTO
  MIXED
}

// Server-controlled. Step 5 only creates DRAFT; scheduling/release sets the rest.
enum MessageStatus {
  DRAFT
  SCHEDULED
  RELEASED
  CANCELLED
}

// Private content owned by one customer. Only RELEASED messages may ever be
// shown to a Recipient, and only through a RecipientMessageAccessGrant.
model Message {
  id          String @id @default(uuid()) @db.Uuid
  ownerUserId String @db.Uuid
  owner       User   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  title       String
  contentType MessageContentType @default(TEXT)
  textContent String?
  status      MessageStatus      @default(DRAFT)

  recipients   MessageRecipient[]
  schedule     MessageSchedule?
  mediaAssets  MediaAsset[]
  release         MessageRelease?
  accessGrants    RecipientMessageAccessGrant[]
  deathActivation DeathTriggeredMessageActivation?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([ownerUserId])
  @@index([ownerUserId, status])
}

// "This message is intended for this Recipient", not "may read it now".
// Pre-release assignment only; Recipient Portal access uses the grant below.
model MessageRecipient {
  id          String    @id @default(uuid()) @db.Uuid
  messageId   String    @db.Uuid
  message     Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  recipientId String    @db.Uuid
  recipient   Recipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([messageId, recipientId])
  @@index([recipientId])
}

// Product trigger types. The API accepts only FIXED_DATE, ON_DEATH and
// AFTER_DEATH for now; the others are reserved (docs/scheduling.md).
enum ReleaseTriggerType {
  NOW
  FIXED_DATE
  BIRTHDAY
  ANNIVERSARY
  CUSTOM_EVENT
  ON_DEATH
  AFTER_DEATH
  ANNUAL_AFTER_DEATH
}

// When a message is intended to become releasable. PostgreSQL is the source
// of truth; Step 12 executes FIXED_DATE only (docs/message-release.md).
// Hard-deleted on unschedule (the Message stays); kept after release. The
// migration adds a CHECK that the fields match the trigger type.
model MessageSchedule {
  id        String  @id @default(uuid()) @db.Uuid
  messageId String  @unique @db.Uuid
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  triggerType    ReleaseTriggerType
  scheduledFor   DateTime? // FIXED_DATE only, UTC instant
  afterDeathDays Int? // AFTER_DEATH only

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Durable evidence that a Message reached RELEASED (Step 12). Written in the
// same transaction as the status change; at most one per Message, so retries
// and concurrent workers cannot release twice. Release is not delivery: no
// content, recipient data or URLs are copied here (contact snapshots live in
// RecipientMessageAccessGrant).
model MessageRelease {
  id        String  @id @default(uuid()) @db.Uuid
  messageId String  @unique @db.Uuid
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  // Copied from the MessageSchedule that was executed.
  triggerType  ReleaseTriggerType
  scheduledFor DateTime?
  releasedAt   DateTime

  accessGrants RecipientMessageAccessGrant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Post-release authorization (Step 13): this released Message was released to
// this Recipient, reachable by these contact details. Written in the release
// transaction and frozen: later Recipient edits or soft deletes do not move or
// revoke it. Only contact details are copied, never notes, birthday or
// relationship. Internal only; never returned by the API.
model RecipientMessageAccessGrant {
  id               String         @id @default(uuid()) @db.Uuid
  messageReleaseId String         @db.Uuid
  messageRelease   MessageRelease @relation(fields: [messageReleaseId], references: [id], onDelete: Cascade)
  messageId        String         @db.Uuid
  message          Message        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  // Cascade, not Restrict: the API only soft-deletes Recipients, so a grant
  // survives "remove from People I Love". A hard delete only happens when the
  // owner account itself is deleted, which removes the Messages anyway;
  // Restrict/NoAction would block that account deletion.
  recipientId      String         @db.Uuid
  recipient        Recipient      @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  // Snapshots at release time. Email: trimmed + lowercased (same as the API).
  // Mobile: as stored (no normalization exists yet; SMS OTP is deferred).
  recipientEmailNormalized  String?
  recipientMobileNormalized String?

  createdAt DateTime @default(now())

  @@unique([messageReleaseId, recipientId])
  @@index([messageId])
  @@index([recipientId])
  @@index([recipientEmailNormalized])
  @@index([recipientMobileNormalized])
}

// VIDEO is reserved; the API accepts PHOTO and AUDIO only.
enum MediaKind {
  PHOTO
  AUDIO
  VIDEO
}

enum MediaAssetStatus {
  PENDING_UPLOAD
  READY
  FAILED
}

// A file attached to a draft Message. The bytes live in a private
// S3-compatible bucket and never pass through the API; only this metadata is
// stored. storageKey is server-generated and never leaves the API.
model MediaAsset {
  id          String  @id @default(uuid()) @db.Uuid
  ownerUserId String  @db.Uuid
  owner       User    @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  messageId   String  @db.Uuid
  message     Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  kind       MediaKind
  status     MediaAssetStatus @default(PENDING_UPLOAD)
  storageKey String           @unique

  originalFileName String // metadata only, never used as a path
  mimeType         String
  sizeBytes        Int // expected size, verified against storage on complete

  uploadedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([ownerUserId])
  @@index([messageId, status])
}

// Fixed list; no custom categories yet.
enum MemoryVaultCategory {
  FAMILY
  TRAVEL
  CHILDHOOD
  FUNNY_STORIES
  LIFE_LESSONS
  RECIPES
  LOVE_STORIES
  OTHER
}

// Private content kept by one customer. Not a Message: no status, recipients,
// schedule or release; any mix of text, photos and audio is valid.
model MemoryVaultItem {
  id          String @id @default(uuid()) @db.Uuid
  ownerUserId String @db.Uuid
  owner       User   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  title       String
  category    MemoryVaultCategory
  textContent String?

  mediaAssets MemoryVaultMediaAsset[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([ownerUserId])
  @@index([ownerUserId, category])
}

// Same storage, rules and lifecycle as MediaAsset (Step 7), attached to a
// Memory Vault item instead of a Message. storageKey never leaves the API.
model MemoryVaultMediaAsset {
  id                String          @id @default(uuid()) @db.Uuid
  ownerUserId       String          @db.Uuid
  owner             User            @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  memoryVaultItemId String          @db.Uuid
  memoryVaultItem   MemoryVaultItem @relation(fields: [memoryVaultItemId], references: [id], onDelete: Cascade)

  kind       MediaKind
  status     MediaAssetStatus @default(PENDING_UPLOAD)
  storageKey String           @unique

  originalFileName String // metadata only, never used as a path
  mimeType         String
  sizeBytes        Int // expected size, verified against storage on complete

  uploadedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([ownerUserId])
  @@index([memoryVaultItemId, status])
}

// A customer's private answer to one guided My Story prompt. The prompts
// themselves are application content (src/my-story/my-story.prompts.ts), not
// rows. One row per owner and prompt: a new save after a soft delete restores
// the row. No recipients, schedule, release or media.
model MyStoryResponse {
  id          String @id @default(uuid()) @db.Uuid
  ownerUserId String @db.Uuid
  owner       User   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  promptKey          String
  // Copied from the catalogue on save, never from the client.
  promptTextSnapshot String
  promptVersion      Int

  textContent String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([ownerUserId, promptKey])
}

// A customer's private answer to one My Wishes prompt: personal preferences
// and guidance only, never a will or any legal, medical or financial
// instruction. Same shape and rules as MyStoryResponse, kept as its own table.
// Prompts are application content (src/my-wishes/my-wishes.prompts.ts).
model MyWishResponse {
  id          String @id @default(uuid()) @db.Uuid
  ownerUserId String @db.Uuid
  owner       User   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  promptKey          String
  // Copied from the catalogue on save, never from the client.
  promptTextSnapshot String
  promptVersion      Int

  textContent String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([ownerUserId, promptKey])
}
