# Copy to .env and fill in. Never commit real values.
NODE_ENV=development

PORT=4000

# Swagger UI at /api/docs and the OpenAPI JSON at /api/docs-json.
# Empty: on only when NODE_ENV=development. "true" | "false" overrides
# (production stays off unless explicitly set to true, e.g. on staging).
SWAGGER_ENABLED=

DATABASE_URL=

OBSERVE_APP_KEY=

OBSERVE_APP_SECRET=

REDIS_URL=

SESSION_SECRET=

FRONTEND_URL=

WORDPRESS_URL=

SESSION_TTL_SECONDS=604800

# Phase 04: emailed single-use links (docs/authentication.md). Defaults shown.
EMAIL_VERIFICATION_TOKEN_TTL_SECONDS=86400
PASSWORD_RESET_TOKEN_TTL_SECONDS=3600
# Redis namespace for the shared login/register/reset rate-limit counters.
# Leave empty (default for_after:throttle:); e2e tests set one per test file.
THROTTLE_KEY_PREFIX=

# Media provider (Phase 12): ImageKit for every new PHOTO/AUDIO/VIDEO upload.
# Files are private; only short-lived signed URLs serve them. Backend only:
# never put the private key in the frontend. From the ImageKit dashboard
# (Developer options): public key, private key and URL endpoint
# (e.g. https://ik.imagekit.io/<your_imagekit_id>).
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# LEGACY (optional): the Backblaze B2 bucket that held media before Phase 12.
# Only read and owner-requested delete of rows still marked B2; nothing is
# uploaded there. Leave empty once no B2 rows remain (docs/media-storage.md).
OBJECT_STORAGE_PROVIDER=backblaze-b2
# Region only, e.g. us-east-005 (not the hostname)
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
# e.g. https://s3.<region>.backblazeb2.com
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=false

MEDIA_UPLOAD_URL_TTL_SECONDS=600
MEDIA_ACCESS_URL_TTL_SECONDS=300
# Size limits follow the ImageKit Free plan's upload limits (provider limits,
# not product decisions): photo 20 MB (its image-processing limit), audio
# 25 MB, video 100 MB (MiB). These values are also the defaults when unset.
# Raise only with a plan that allows it.
MEDIA_PHOTO_MAX_BYTES=20971520
MEDIA_AUDIO_MAX_BYTES=26214400
MEDIA_VIDEO_MAX_BYTES=104857600
# Phase 09: a Person I Love's private profile photo (JPEG/PNG/WebP).
RECIPIENT_PHOTO_MAX_BYTES=5242880
# Retries failed file deletions and retires abandoned uploads (hourly; 0 = off).
MEDIA_CLEANUP_INTERVAL_SECONDS=3600
# Phase 12B: every upload is malware-scanned by ClamAV (clamd, TCP INSTREAM)
# before READY. Required: the app does not start without CLAMAV_HOST, and there
# is no switch to turn scanning off. clamd's StreamMaxLength must be >= the
# largest limit above (100 MB video). Local: docs/media-storage.md section 2e.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
# Download + scan of one file (fails closed with a 503 when exceeded).
MEDIA_MALWARE_SCAN_TIMEOUT_MS=120000
# Phase 12C: storage limit per Customer, in bytes (default 5 GiB = 5368709120;
# approved 2026-10-08 until per-plan limits come with billing). Counts READY
# files plus uploads in progress; enforced before an upload is signed.
STORAGE_LIMIT_BYTES=5368709120

# Message release (Step 12). BullMQ uses QUEUE_REDIS_URL, or REDIS_URL if empty.
QUEUE_REDIS_URL=
RELEASE_QUEUE_NAME=message-release
# Only FIXED_DATE releases due within this window are put in Redis.
RELEASE_QUEUE_LOOKAHEAD_SECONDS=86400
RELEASE_RECONCILE_INTERVAL_SECONDS=60
RELEASE_JOB_ATTEMPTS=5
RELEASE_JOB_BACKOFF_MS=5000

# Recipient Portal (Step 13). Passwordless email OTP + its own session cookie.
RECIPIENT_OTP_TTL_SECONDS=600
RECIPIENT_OTP_MAX_ATTEMPTS=5
# Per email, per window. IP limits cover many emails from one address.
RECIPIENT_OTP_REQUEST_LIMIT=5
RECIPIENT_OTP_REQUEST_WINDOW_SECONDS=900
RECIPIENT_OTP_IP_REQUEST_LIMIT=20
RECIPIENT_OTP_VERIFY_IP_LIMIT=30
# Required, random, at least 32 characters. Used to HMAC codes; never logged.
RECIPIENT_OTP_PEPPER=
# Codes are emailed through EMAIL_PROVIDER (below).
RECIPIENT_SESSION_TTL_SECONDS=604800
# Empty on localhost; .forafter.com.au in production.
RECIPIENT_COOKIE_DOMAIN=

# Trusted Contact email OTP (Step 14). Separate pepper, Redis namespace,
# session and cookie from the Recipient Portal. Eligible: any email that is an
# active (non-deleted) Trusted Contact of an active Customer.
TRUSTED_CONTACT_OTP_TTL_SECONDS=600
TRUSTED_CONTACT_OTP_MAX_ATTEMPTS=5
# Per email, per window. IP limits cover many emails from one address.
TRUSTED_CONTACT_OTP_REQUEST_LIMIT=5
TRUSTED_CONTACT_OTP_REQUEST_WINDOW_SECONDS=900
TRUSTED_CONTACT_OTP_IP_REQUEST_LIMIT=20
TRUSTED_CONTACT_OTP_VERIFY_IP_LIMIT=30
# Required, random, at least 32 characters, different from RECIPIENT_OTP_PEPPER.
TRUSTED_CONTACT_OTP_PEPPER=
# Codes are emailed through EMAIL_PROVIDER (below).
TRUSTED_CONTACT_SESSION_TTL_SECONDS=604800
# Empty on localhost; .forafter.com.au in production.
TRUSTED_CONTACT_COOKIE_DOMAIN=
# Phase 10: how long an emailed Trusted Contact invitation link works. Technical
# default (7 days), not a product decision. Invitations are email only.
TRUSTED_CONTACT_INVITATION_TTL_SECONDS=604800

# Death verification workflow (Step 15). A report sends the account holder a
# safety notice; only after a successful send does the safeguard window start.
# When it ends the case is READY_FOR_REVIEW; only an admin can verify it.
# 1209600 s = 14 days. Local testing may use 60 or 120; never in production.
# Each case stores safeguardEndsAt, so changing this never moves a running window.
DEATH_VERIFICATION_SAFEGUARD_SECONDS=1209600
DEATH_VERIFICATION_QUEUE_NAME=death-verification
DEATH_VERIFICATION_RECONCILE_INTERVAL_SECONDS=60
DEATH_VERIFICATION_JOB_ATTEMPTS=5
DEATH_VERIFICATION_JOB_BACKOFF_MS=5000
# The safety notice is emailed through EMAIL_PROVIDER (below). If it cannot be
# sent (e.g. EMAIL_PROVIDER=disabled), no safeguard starts.

# Admin backend (Step 16). ADMIN / SUPER_ADMIN must pass TOTP after the
# password; the password alone never creates a session.
ADMIN_TOTP_CHALLENGE_TTL_SECONDS=300
# Wrong codes per password challenge; then the password is needed again.
ADMIN_TOTP_MAX_ATTEMPTS=5
# TOTP / recovery-code attempts per IP per 15 minutes (Redis, all instances).
ADMIN_TOTP_VERIFY_IP_LIMIT=20
# Admin sessions end after this long without a request (Customers unaffected).
ADMIN_SESSION_IDLE_TIMEOUT_SECONDS=1800
ADMIN_TOTP_ISSUER=For After
# Required: 32 random bytes, base64 (`openssl rand -base64 32`). Encrypts
# admin TOTP secrets (AES-256-GCM). Dedicated: never reuse SESSION_SECRET or
# an OTP pepper. Losing or changing it forces every admin to re-enroll.
ADMIN_TOTP_ENCRYPTION_KEY=

# --- Email (Step 24, docs/email-production-setup.md) -------------------------
# brevo (the active provider) | resend (optional adapter, not active) | console
# (NODE_ENV=development only: prints emails, sign-in codes included, to the API
# console) | disabled (default outside production: nothing is sent; OTPs and
# safety notices fail). Production requires brevo or resend.
EMAIL_PROVIDER=console
# Brevo: a v3 API key (xkeysib-…, not an SMTP key). Required with
# EMAIL_PROVIDER=brevo. Server-side only: never in the frontend, a
# NEXT_PUBLIC_* variable or a log. Brevo refuses unknown IPs: authorise the
# server's IP at app.brevo.com/security/authorised_ips.
BREVO_API_KEY=
# Optional Resend adapter: only read with EMAIL_PROVIDER=resend.
RESEND_API_KEY=
EMAIL_FROM_NAME=For After
# A sender verified in Brevo (Senders, Domains & Dedicated IPs). A verified
# personal address works for development; no custom domain is required.
# Required with brevo or resend (Resend: a sender on a verified domain).
EMAIL_FROM_ADDRESS=
# The app origin used in email links (no path). https in production.
APP_BASE_URL=http://localhost:3000
# Optional tuning (defaults shown).
EMAIL_SEND_TIMEOUT_MS=10000
EMAIL_QUEUE_NAME=email-delivery
EMAIL_JOB_ATTEMPTS=5
EMAIL_JOB_BACKOFF_MS=30000
EMAIL_RECONCILE_INTERVAL_SECONDS=60
