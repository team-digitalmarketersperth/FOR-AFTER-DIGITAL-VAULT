generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PASSED
  DELETED
}

model User {
  id           String @id @default(uuid()) @db.Uuid
  email        String @unique
  passwordHash String

  firstName String?
  lastName  String?

  role   UserRole   @default(CUSTOMER)
  status UserStatus @default(ACTIVE)

  emailVerifiedAt   DateTime?
  twoFactorEnabled  Boolean   @default(false)
  passedAt          DateTime?
  // Step 22: sessions signed in before this are refused (SessionAuthGuard).
  passwordChangedAt DateTime?
  // Phase 08: the same for a confirmed email change (sign in again).
  emailChangedAt    DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  recipients      Recipient[]
  trustedContacts TrustedContact[]
  messages        Message[]
  mediaAssets     MediaAsset[]

  memoryVaultItems                   MemoryVaultItem[]
  memoryVaultMediaAssets             MemoryVaultMediaAsset[]
  memoryVaultTags                    MemoryVaultTag[]
  myStoryMediaAssets                 MyStoryMediaAsset[]
  myWishMediaAssets                  MyWishMediaAsset[]
  myWishesDisclaimerAcknowledgements MyWishesDisclaimerAcknowledgement[]

  myStoryResponses MyStoryResponse[]
  myWishResponses  MyWishResponse[]

  // Phase 10: history. At most one open (or VERIFIED) case per Customer,
  // enforced by a partial unique index in the migration.
  deathVerificationCases DeathVerificationCase[]

  // ADMIN / SUPER_ADMIN only (Step 16).
  adminMfaCredential    AdminMfaCredential?
  adminMfaRecoveryCodes AdminMfaRecoveryCode[]

  authTokens AuthToken[]

  recipientPhotos RecipientPhoto[]
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  EMAIL_CHANGE
}

// Phase 04. Single-use emailed links (verify email, reset password). Only the
// SHA-256 of the 32-byte random token is stored; the raw token exists only in
// the email. Consumed (or superseded by a newer one) by setting consumedAt.
// Rows are kept: the last hour's rows are the per-account send cap.
model AuthToken {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @db.Uuid
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose    AuthTokenPurpose
  tokenHash  String           @unique
  // EMAIL_CHANGE only: the requested address, normalized. User.email changes
  // only when this token is confirmed.
  newEmail   String?
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime         @default(now())

  @@index([userId, purpose, createdAt])
}

// Admin TOTP (Step 16). Written by setup with enabledAt null; confirm sets
// enabledAt. The secret is AES-256-GCM encrypted with ADMIN_TOTP_ENCRYPTION_KEY
// and never leaves the API after enrollment.
model AdminMfaCredential {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  totpSecretEncrypted String
  enabledAt           DateTime?
  // RFC 6238 time step of the last accepted code; replays of it or older fail.
  lastUsedTimeStep    BigInt?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One-time admin recovery codes. Only a SHA-256 of each (80-bit) code is stored.
model AdminMfaRecoveryCode {
  id       String    @id @default(uuid()) @db.Uuid
  userId   String    @db.Uuid
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash String    @unique
  usedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
}

enum AuditEventType {
  ADMIN_PASSWORD_AUTH_SUCCEEDED
  ADMIN_MFA_SETUP_COMPLETED
  ADMIN_MFA_VERIFIED
  ADMIN_MFA_FAILED
  ADMIN_RECOVERY_CODE_USED
  ADMIN_LOGIN
  ADMIN_LOGOUT
  USER_SUSPENDED
  USER_REACTIVATED
  ADMIN_VIEWED_USER
  ADMIN_VIEWED_DEATH_CASE
  DEATH_VERIFICATION_VERIFIED
  DEATH_VERIFICATION_REJECTED
  FAILED_JOB_RETRIED
  // Customer events (Step 22).
  PASSWORD_CHANGED
  // Phase 04: email verification and password reset.
  EMAIL_VERIFIED
  PASSWORD_RESET_COMPLETED
  // Phase 08: change email. No addresses in metadata (personal data).
  EMAIL_CHANGE_REQUESTED
  EMAIL_CHANGED
  // Phase 10: Trusted Contact invitations. No addresses or tokens in metadata.
  TRUSTED_CONTACT_INVITATION_SENT
  TRUSTED_CONTACT_INVITATION_ACCEPTED
  TRUSTED_CONTACT_INVITATION_DECLINED
  // Phase 15A: the version only (never wish content or the notice text).
  MY_WISHES_DISCLAIMER_ACKNOWLEDGED
}

// Admin actors (Step 16), the Customer acting on their own account (Step 22)
// and an invited Trusted Contact answering an invitation (Phase 10; actorUserId
// null, subjectId = the TrustedContact id).
enum AuditActorType {
  ADMIN
  SUPER_ADMIN
  CUSTOMER
  TRUSTED_CONTACT
}

// Generic append-only audit trail (Step 16). The migration adds a trigger that
// rejects UPDATE and DELETE. Plain ids, no FKs, so history outlives accounts.
// Never holds secrets, codes, private content or raw IPs (ipPrefix is /24 or /48).
model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  eventType   AuditEventType
  actorType   AuditActorType
  actorUserId String?        @db.Uuid

  subjectType String?
  subjectId   String?

  ipPrefix  String?
  userAgent String?

  metadata Json?

  createdAt DateTime @default(now())

  @@index([eventType])
  @@index([actorUserId])
  @@index([subjectType, subjectId])
  @@index([createdAt])
}

// "People I Love". A contact record owned by one customer, not a login account.
model Recipient {
  id          String @id @default(uuid()) @db.Uuid
  ownerUserId String @db.Uuid
  owner       User   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  firstName    String
  lastName     String?
  relationship String?
  email        String?
  mobile       String?
  // Calendar date only (no time/timezone), so it cannot shift a day.
  birthday     DateTime? @db.Date
  privateNote  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  messageRecipients MessageRecipient[]
  accessGrants      RecipientMessageAccessGrant[]
  // Phase 09: at most one READY, non-deleted photo (partial unique index in
  // the migration). Customer-managed; the Recipient never sees it.
  photos            RecipientPhoto[]

  @@index([ownerUserId])
}

// Nominated to help with post-death actions. An owned contact record, never
// a User: no password or role. Signs in by email OTP (Step 14) to report a
// death, and gets no access to the owner's content.
// The migration adds a CHECK that email or mobile is set.
model TrustedContact {
  id          String @id @default(uuid()) @db.Uuid
  ownerUserId String @db.Uuid
  owner       User   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  firstName    String
  lastName     String?
  relationship String?
  email        String? // stored normalized (trim + lowercase)
  mobile       String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  deathReports DeathReport[]
  invitations  TrustedContactInvitation[]

  @@index([ownerUserId])
  // Trusted Contact OTP eligibility and account lookup by signed-in email.
  @@index([email])
}

// Stored states only. EXPIRED is not stored: a PENDING row past expiresAt.
enum TrustedContactInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  // Superseded by a newer invitation, or the Trusted Contact was removed.
  CANCELLED
}

// Phase 10: an emailed invitation to be a Trusted Contact (email only; SMS is
// deferred). Only the SHA-256 of the 32-byte token is stored. Accepting only
// records consent: it creates no session and grants no access (sign-in stays
// email OTP). emailNormalized is the address it was sent to; it only works
// while the Trusted Contact still has that email. The migration adds a partial
// unique index: at most one PENDING invitation per Trusted Contact.
model TrustedContactInvitation {
  id               String         @id @default(uuid()) @db.Uuid
  trustedContactId String         @db.Uuid
  trustedContact   TrustedContact @relation(fields: [trustedContactId], references: [id], onDelete: Cascade)

  emailNormalized String
  tokenHash       String                         @unique
  status          TrustedContactInvitationStatus @default(PENDING)
  expiresAt       DateTime
  acceptedAt      DateTime?
  declinedAt      DateTime?
  cancelledAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([trustedContactId, createdAt])
}

// PENDING_VERIFICATION → SAFEGUARD_ACTIVE → READY_FOR_REVIEW → VERIFIED (Step 15).
// CANCELLED (Customer confirmed alive, from any open state) and REJECTED
// (admin, from READY_FOR_REVIEW) are terminal, like VERIFIED.
enum DeathVerificationCaseStatus {
  PENDING_VERIFICATION
  SAFEGUARD_ACTIVE
  READY_FOR_REVIEW
  VERIFIED
  REJECTED
  CANCELLED
}

// One verification cycle. A Customer may have many over time (Phase 10): a
// report after a CANCELLED/REJECTED case opens a NEW case and the old one stays
// as immutable history. A partial unique index in the migration allows at most
// one case per Customer in an open status or VERIFIED, so there is never a
// second open case and never a new case after a verified death. A report is NOT proof of death. Only an
// explicit admin verification (VERIFIED) activates death-triggered Messages;
// nothing else changes the User, Messages, schedules, releases or grants.
model DeathVerificationCase {
  id                 String  @id @default(uuid()) @db.Uuid
  ownerUserId        String  @db.Uuid
  owner              User    @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  // The closed (CANCELLED/REJECTED) case this one follows, as plain history.
  reopenedFromCaseId String? @db.Uuid

  status     DeathVerificationCaseStatus @default(PENDING_VERIFICATION)
  openedAt   DateTime                    @default(now())
  // Set with every terminal status (VERIFIED, REJECTED, CANCELLED).
  resolvedAt DateTime?

  // Safety notice to the account holder; the safeguard starts only after a
  // successful send. safeguardEndsAt is stored, so a later config change never
  // moves a running window.
  safetyNoticeSentAt        DateTime?
  safetyNoticeLastAttemptAt DateTime?
  safetyNoticeAttemptCount  Int       @default(0)
  safeguardStartedAt        DateTime?
  safeguardEndsAt           DateTime?

  // verifiedDeathAt = the approved time of death (drives AFTER_DEATH);
  // verifiedAt = when For After approved it (drives ON_DEATH).
  verifiedAt        DateTime?
  verifiedDeathAt   DateTime?
  // Admin ids are kept as plain history (no FK), like audit actors.
  verifiedByUserId  String?   @db.Uuid
  rejectedAt        DateTime?
  rejectedByUserId  String?   @db.Uuid
  cancelledAt       DateTime?
  // Admin-only; never returned to Customers, Trusted Contacts or Recipients.
  adminDecisionNote String?

  // Activation rows were built for every then-scheduled death-trigger Message.
  // Not proof that anything has been released.
  deathTriggersActivatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reports     DeathReport[]
  auditEvents DeathVerificationAuditEvent[]
  activations DeathTriggeredMessageActivation[]

  @@index([ownerUserId, openedAt])
  @@index([status])
}

enum DeathVerificationAuditEventType {
  REPORT_RECEIVED
  // Phase 10: this case was opened by a report after a closed (CANCELLED or
  // REJECTED) case; the case's reopenedFromCaseId names that case.
  CASE_REOPENED
  SAFETY_NOTICE_SENT
  SAFEGUARD_STARTED
  SAFEGUARD_ELAPSED
  CUSTOMER_CONFIRMED_ALIVE
  ADMIN_VERIFIED
  ADMIN_REJECTED
  DEATH_TRIGGER_ACTIVATION_STARTED
  DEATH_TRIGGER_ACTIVATION_COMPLETED
}

enum DeathVerificationActorType {
  SYSTEM
  CUSTOMER
  TRUSTED_CONTACT
  ADMIN
}

// Append-only history of a case. Written in the same transaction as the change
// it records. No free text or JSON: notes live on the case/report only.
model DeathVerificationAuditEvent {
  id                      String                @id @default(uuid()) @db.Uuid
  deathVerificationCaseId String                @db.Uuid
  deathVerificationCase   DeathVerificationCase @relation(fields: [deathVerificationCaseId], references: [id], onDelete: Cascade)

  eventType             DeathVerificationAuditEventType
  actorType             DeathVerificationActorType
  // Plain ids (no FK) so history survives a later account or contact deletion.
  actorUserId           String?                         @db.Uuid
  actorTrustedContactId String?                         @db.Uuid

  createdAt DateTime @default(now())

  @@index([deathVerificationCaseId, createdAt])
}

// Durable execution state for ON_DEATH / AFTER_DEATH Messages after a VERIFIED
// case. MessageSchedule keeps its original meaning; dueAt lives here.
model DeathTriggeredMessageActivation {
  id        String  @id @default(uuid()) @db.Uuid
  messageId String  @unique @db.Uuid
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  deathVerificationCaseId String                @db.Uuid
  deathVerificationCase   DeathVerificationCase @relation(fields: [deathVerificationCaseId], references: [id], onDelete: Cascade)

  triggerType ReleaseTriggerType
  activatedAt DateTime
  // ON_DEATH: verifiedAt. AFTER_DEATH: verifiedDeathAt + afterDeathDays.
  dueAt       DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deathVerificationCaseId])
  @@index([dueAt])
}

// One report per Trusted Contact per case. Reporter details are snapshots
// taken at submission, so later edits to the TrustedContact never change it.
model DeathReport {
  id                      String                @id @default(uuid()) @db.Uuid
  deathVerificationCaseId String                @db.Uuid
  deathVerificationCase   DeathVerificationCase @relation(fields: [deathVerificationCaseId], references: [id], onDelete: Cascade)

  // Cascade, like RecipientMessageAccessGrant: Restrict/NoAction would block
  // deleting the owner's account, because PostgreSQL checks them after the
  // TrustedContact cascade and before the case cascade. The API only
  // soft-deletes Trusted Contacts, so reports survive a contact's removal;
  // the only hard delete is the owner's, which removes the case anyway.
  reportedByTrustedContactId String         @db.Uuid
  reportedByTrustedContact   TrustedContact @relation(fields: [reportedByTrustedContactId], references: [id], onDelete: Cascade)

  reporterFirstNameSnapshot String
  reporterLastNameSnapshot  String?
  reporterEmailNormalized   String?
  reporterMobileNormalized  String?

  // Calendar date only (no time/timezone), so it cannot shift a day.
  reportedDateOfDeath DateTime? @db.Date
  note                String?

  createdAt DateTime @default(now())

  @@unique([deathVerificationCaseId, reportedByTrustedContactId])
  @@index([reportedByTrustedContactId])
}

// Future values are defined now; the API only accepts TEXT until media exists.
enum MessageContentType {
  TEXT
  VIDEO
  AUDIO
  PHOTO
  MIXED
}

// Server-controlled. Step 5 only creates DRAFT; scheduling/release sets the rest.
enum MessageStatus {
  DRAFT
  SCHEDULED
  RELEASED
  CANCELLED
}

// Private content owned by one customer. Only RELEASED messages may ever be
// shown to a Recipient, and only through a RecipientMessageAccessGrant.
model Message {
  id          String @id @default(uuid()) @db.Uuid
  ownerUserId String @db.Uuid
  owner       User   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  title       String
  contentType MessageContentType @default(TEXT)
  textContent String?
  status      MessageStatus      @default(DRAFT)

  recipients      MessageRecipient[]
  schedule        MessageSchedule?
  mediaAssets     MediaAsset[]
  release         MessageRelease?
  accessGrants    RecipientMessageAccessGrant[]
  deathActivation DeathTriggeredMessageActivation?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([ownerUserId])
  @@index([ownerUserId, status])
}

// "This message is intended for this Recipient", not "may read it now".
// Pre-release assignment only; Recipient Portal access uses the grant below.
model MessageRecipient {
  id          String    @id @default(uuid()) @db.Uuid
  messageId   String    @db.Uuid
  message     Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  recipientId String    @db.Uuid
  recipient   Recipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([messageId, recipientId])
  @@index([recipientId])
}

// Product trigger types. The API accepts only FIXED_DATE, ON_DEATH and
// AFTER_DEATH for now; the others are reserved (docs/scheduling.md).
enum ReleaseTriggerType {
  NOW
  FIXED_DATE
  BIRTHDAY
  ANNIVERSARY
  CUSTOM_EVENT
  ON_DEATH
  AFTER_DEATH
  ANNUAL_AFTER_DEATH
}

// When a message is intended to become releasable. PostgreSQL is the source
// of truth; Step 12 executes FIXED_DATE only (docs/message-release.md).
// Hard-deleted on unschedule (the Message stays); kept after release. The
// migration adds a CHECK that the fields match the trigger type.
model MessageSchedule {
  id        String  @id @default(uuid()) @db.Uuid
  messageId String  @unique @db.Uuid
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  triggerType    ReleaseTriggerType
  scheduledFor   DateTime? // FIXED_DATE only, UTC instant
  afterDeathDays Int? // AFTER_DEATH only

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Durable evidence that a Message reached RELEASED (Step 12). Written in the
// same transaction as the status change; at most one per Message, so retries
// and concurrent workers cannot release twice. Release is not delivery: no
// content, recipient data or URLs are copied here (contact snapshots live in
// RecipientMessageAccessGrant).
model MessageRelease {
  id        String  @id @default(uuid()) @db.Uuid
  messageId String  @unique @db.Uuid
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  // Copied from the MessageSchedule that was executed.
  triggerType  ReleaseTriggerType
  scheduledFor DateTime?
  releasedAt   DateTime

  accessGrants RecipientMessageAccessGrant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Post-release authorization (Step 13): this released Message was released to
// this Recipient, reachable by these contact details. Written in the release
// transaction and frozen: later Recipient edits or soft deletes do not move or
// revoke it. Only contact details are copied, never notes, birthday or
// relationship. Internal only; never returned by the API.
model RecipientMessageAccessGrant {
  id               String         @id @default(uuid()) @db.Uuid
  messageReleaseId String         @db.Uuid
  messageRelease   MessageRelease @relation(fields: [messageReleaseId], references: [id], onDelete: Cascade)
  messageId        String         @db.Uuid
  message          Message        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  // Cascade, not Restrict: the API only soft-deletes Recipients, so a grant
  // survives "remove from People I Love". A hard delete only happens when the
  // owner account itself is deleted, which removes the Messages anyway;
  // Restrict/NoAction would block that account deletion.
  recipientId      String         @db.Uuid
  recipient        Recipient      @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  // Snapshots at release time. Email: trimmed + lowercased (same as the API).
  // Mobile: as stored (no normalization exists yet; SMS OTP is deferred).
  recipientEmailNormalized  String?
  recipientMobileNormalized String?

  // Step 24: the "a message is waiting for you" email, if the grant has an email.
  notification ReleaseNotification?
  createdAt    DateTime             @default(now())

  @@unique([messageReleaseId, recipientId])
  @@index([messageId])
  @@index([recipientId])
  @@index([recipientEmailNormalized])
  @@index([recipientMobileNormalized])
}

enum ReleaseNotificationStatus {
  PENDING
  SENT
  FAILED
}

// Step 24. One "a message is waiting for you" email per access grant that has
// an email snapshot, created in the release transaction. The unique grantId is
// the idempotency key: retries, reconciliation and a second worker can never
// make a second row. Operational fields only: no subject, body or content.
model ReleaseNotification {
  id      String                      @id @default(uuid()) @db.Uuid
  grantId String                      @unique @db.Uuid
  grant   RecipientMessageAccessGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  status            ReleaseNotificationStatus @default(PENDING)
  attemptCount      Int                       @default(0)
  // A safe category (e.g. rate_limit_exceeded), never a provider response.
  lastErrorCode     String?
  providerMessageId String?
  sentAt            DateTime?
  failedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

// VIDEO is reserved; the API accepts PHOTO and AUDIO only.
enum MediaKind {
  PHOTO
  AUDIO
  VIDEO
}

enum MediaAssetStatus {
  PENDING_UPLOAD
  READY
  FAILED
}

// Where a media file's bytes live. New uploads always go to IMAGEKIT (Phase 12);
// B2 rows were uploaded before the move and stay readable through the legacy
// adapter. storageKey is the provider path either way, never reinterpreted.
enum MediaStorageProvider {
  B2
  IMAGEKIT
}

// A file attached to a draft Message. The bytes live with a private media
// provider (ImageKit; legacy rows on B2) and never pass through the API; only
// this metadata is stored. storageKey, providerFileId and storageProvider are
// server-controlled and never leave the API.
model MediaAsset {
  id          String  @id @default(uuid()) @db.Uuid
  ownerUserId String  @db.Uuid
  owner       User    @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  messageId   String  @db.Uuid
  message     Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  kind       MediaKind
  status     MediaAssetStatus @default(PENDING_UPLOAD)
  storageKey String           @unique

  storageProvider  MediaStorageProvider @default(IMAGEKIT)
  // Provider's own id, set once the upload is verified (ImageKit fileId).
  providerFileId   String?
  // Set once the provider object is gone; a soft-deleted row without it is
  // retried by the media cleanup reconciler.
  storageDeletedAt DateTime?

  originalFileName String // metadata only, never used as a path
  mimeType         String
  sizeBytes        Int // expected size, verified against storage on complete

  uploadedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([ownerUserId])
  @@index([messageId, status])
}

// Fixed list; no custom categories yet.
enum MemoryVaultCategory {
  FAMILY
  TRAVEL
  CHILDHOOD
  FUNNY_STORIES
  LIFE_LESSONS
  RECIPES
  LOVE_STORIES
  OTHER
}

// Private content kept by one customer. Not a Message: no status, recipients,
// schedule or release; any mix of text, photos and audio is valid.
model MemoryVaultItem {
  id          String @id @default(uuid()) @db.Uuid
  ownerUserId String @db.Uuid
  owner       User   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  title       String
  category    MemoryVaultCategory
  textContent String?

  mediaAssets MemoryVaultMediaAsset[]
  tags        MemoryVaultItemTag[]
  storyLinks  MyStoryMemoryLink[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([ownerUserId])
  @@index([ownerUserId, category])
}

// A Customer's own Memory Vault tag (Phase 13A). Given by name, never by id:
// "Family", " family " and "FAMILY" are one tag (normalizedName = trimmed,
// inner whitespace collapsed, lower-cased); name keeps the first spelling.
// Kept when no memory uses it any more, for reuse.
model MemoryVaultTag {
  id             String @id @default(uuid()) @db.Uuid
  ownerUserId    String @db.Uuid
  owner          User   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  name           String
  normalizedName String

  items MemoryVaultItemTag[]

  createdAt DateTime @default(now())

  @@unique([ownerUserId, normalizedName])
}

model MemoryVaultItemTag {
  memoryVaultItemId String          @db.Uuid
  memoryVaultItem   MemoryVaultItem @relation(fields: [memoryVaultItemId], references: [id], onDelete: Cascade)
  tagId             String          @db.Uuid
  tag               MemoryVaultTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([memoryVaultItemId, tagId])
  @@index([tagId])
}

// Same storage, rules and lifecycle as MediaAsset (Step 7), attached to a
// Memory Vault item instead of a Message. storageKey never leaves the API.
model MemoryVaultMediaAsset {
  id                String          @id @default(uuid()) @db.Uuid
  ownerUserId       String          @db.Uuid
  owner             User            @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  memoryVaultItemId String          @db.Uuid
  memoryVaultItem   MemoryVaultItem @relation(fields: [memoryVaultItemId], references: [id], onDelete: Cascade)

  kind       MediaKind
  status     MediaAssetStatus @default(PENDING_UPLOAD)
  storageKey String           @unique

  storageProvider  MediaStorageProvider @default(IMAGEKIT)
  // Provider's own id, set once the upload is verified (ImageKit fileId).
  providerFileId   String?
  // Set once the provider object is gone; a soft-deleted row without it is
  // retried by the media cleanup reconciler.
  storageDeletedAt DateTime?

  originalFileName String // metadata only, never used as a path
  mimeType         String
  sizeBytes        Int // expected size, verified against storage on complete

  uploadedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([ownerUserId])
  @@index([memoryVaultItemId, status])
}

// A customer's private answer to one guided My Story prompt. The prompts
// themselves are application content (src/my-story/my-story.prompts.ts), not
// rows. One row per owner and prompt: a new save after a soft delete restores
// the row. No recipients, schedule, release or media.
model MyStoryResponse {
  id          String @id @default(uuid()) @db.Uuid
  ownerUserId String @db.Uuid
  owner       User   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  promptKey          String
  // Copied from the catalogue on save, never from the client.
  promptTextSnapshot String
  promptVersion      Int

  // Optional since Phase 14B: an answer may be photos/recordings or linked
  // memories only. The service never lets a saved answer be empty.
  textContent String?

  mediaAssets MyStoryMediaAsset[]
  memoryLinks MyStoryMemoryLink[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([ownerUserId, promptKey])
}

// Phase 14B: PHOTO/AUDIO/VIDEO on a My Story answer. Same storage, rules and
// lifecycle as MemoryVaultMediaAsset (ImageKit, verification, malware scan,
// quota, cleanup). Private: only its owner, never Recipients.
model MyStoryMediaAsset {
  id                String          @id @default(uuid()) @db.Uuid
  ownerUserId       String          @db.Uuid
  owner             User            @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  myStoryResponseId String          @db.Uuid
  myStoryResponse   MyStoryResponse @relation(fields: [myStoryResponseId], references: [id], onDelete: Cascade)

  kind       MediaKind
  status     MediaAssetStatus @default(PENDING_UPLOAD)
  storageKey String           @unique

  storageProvider  MediaStorageProvider @default(IMAGEKIT)
  providerFileId   String?
  storageDeletedAt DateTime?

  originalFileName String // metadata only, never used as a path
  mimeType         String
  sizeBytes        Int // expected size, verified against storage on complete

  uploadedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([ownerUserId])
  @@index([myStoryResponseId, status])
}

// Phase 14B: private context: a My Story answer points at the Customer's own
// memories. A link never shares anything and is never copied into a Message.
model MyStoryMemoryLink {
  myStoryResponseId String          @db.Uuid
  myStoryResponse   MyStoryResponse @relation(fields: [myStoryResponseId], references: [id], onDelete: Cascade)
  memoryVaultItemId String          @db.Uuid
  memoryVaultItem   MemoryVaultItem @relation(fields: [memoryVaultItemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([myStoryResponseId, memoryVaultItemId])
  @@index([memoryVaultItemId])
}

// A customer's private answer to one My Wishes prompt: personal preferences
// and guidance only, never a will or any legal, medical or financial
// instruction. Same shape and rules as MyStoryResponse, kept as its own table.
// Prompts are application content (src/my-wishes/my-wishes.prompts.ts).
model MyWishResponse {
  id          String @id @default(uuid()) @db.Uuid
  ownerUserId String @db.Uuid
  owner       User   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  promptKey          String
  // Copied from the catalogue on save, never from the client.
  promptTextSnapshot String
  promptVersion      Int

  // Optional since Phase 15B: a wish may be photos/recordings only. The
  // service never lets a saved wish be empty.
  textContent String?

  mediaAssets MyWishMediaAsset[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([ownerUserId, promptKey])
}

// Phase 15B: PHOTO/AUDIO/VIDEO on a My Wishes answer. Same storage, rules and
// lifecycle as MyStoryMediaAsset (ImageKit, verification, malware scan,
// quota, cleanup). Private: only its owner, never Recipients, Trusted
// Contacts or admins. Shared only as a copy inside a new Message.
model MyWishMediaAsset {
  id               String         @id @default(uuid()) @db.Uuid
  ownerUserId      String         @db.Uuid
  owner            User           @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  myWishResponseId String         @db.Uuid
  myWishResponse   MyWishResponse @relation(fields: [myWishResponseId], references: [id], onDelete: Cascade)

  kind       MediaKind
  status     MediaAssetStatus @default(PENDING_UPLOAD)
  storageKey String           @unique

  storageProvider  MediaStorageProvider @default(IMAGEKIT)
  providerFileId   String?
  storageDeletedAt DateTime?

  originalFileName String // metadata only, never used as a path
  mimeType         String
  sizeBytes        Int // expected size, verified against storage on complete

  uploadedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([ownerUserId])
  @@index([myWishResponseId, status])
}

// Phase 15A (approved 2026-10-08): a Customer read the My Wishes non-legal
// notice in this version before writing wishes. An acknowledgement only:
// never consent, a waiver or anything legal. One row per user and version,
// kept as history (a new version needs a new row). Existing users are never
// backfilled. No IP, device or wish content.
model MyWishesDisclaimerAcknowledgement {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  disclaimerVersion Int
  acknowledgedAt    DateTime @default(now())

  @@unique([userId, disclaimerVersion])
}

// Phase 09: a Customer's private profile photo for one Recipient. Same storage,
// lifecycle and verification as other media (docs/media-storage.md); PHOTO
// only. A new upload becomes the photo only once READY, superseding the old
// one (soft delete + best-effort object removal). storageKey never leaves the API.
model RecipientPhoto {
  id          String    @id @default(uuid()) @db.Uuid
  ownerUserId String    @db.Uuid
  owner       User      @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  recipientId String    @db.Uuid
  recipient   Recipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  kind       MediaKind        @default(PHOTO)
  status     MediaAssetStatus @default(PENDING_UPLOAD)
  storageKey String           @unique

  storageProvider  MediaStorageProvider @default(IMAGEKIT)
  // Provider's own id, set once the upload is verified (ImageKit fileId).
  providerFileId   String?
  // Set once the provider object is gone; a soft-deleted row without it is
  // retried by the media cleanup reconciler.
  storageDeletedAt DateTime?

  originalFileName String // metadata only, never used as a path
  mimeType         String
  sizeBytes        Int // expected size, verified against storage on complete

  uploadedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([ownerUserId])
  @@index([recipientId, status])
}
